# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/ecommerce_db
DB_USERNAME=postgres
DB_PASSWORD=change-me

# Salesforce Pub/Sub (set enabled to true after supplying all values)
SALESFORCE_PUBSUB_ENABLED=false
SALESFORCE_INSTANCE_URL=
SALESFORCE_TENANT_ID=
SALESFORCE_ACCESS_TOKEN=
SALESFORCE_PUBSUB_HOST=api.pubsub.salesforce.com
SALESFORCE_PUBSUB_PORT=7443
SALESFORCE_PUBSUB_TOPIC=/event/Contact_Updated__e
SALESFORCE_PUBSUB_BATCH_SIZE=5

# OAuth server settings (replace before sharing/deploying)
OAUTH_CLIENT_ID=salesforce-client
OAUTH_CLIENT_SECRET=change-me
OAUTH_ISSUER=http://localhost:8080
